{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Sender email"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender full name"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "channel": {
      "type": "string",
      "default": "general",
      "description": "Chat channel (general, or project-specific ID)"
    }
  },
  "required": [
    "sender_email",
    "message"
  ]
}