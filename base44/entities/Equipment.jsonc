{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Equipment name"
    },
    "type": {
      "type": "string",
      "enum": [
        "tool",
        "heavy_machinery",
        "vehicle",
        "safety_equipment",
        "power_tool",
        "other"
      ],
      "default": "tool"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial or asset number"
    },
    "brand": {
      "type": "string",
      "description": "Brand/manufacturer"
    },
    "model": {
      "type": "string",
      "description": "Model number"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_use",
        "maintenance",
        "out_of_service",
        "reserved"
      ],
      "default": "available"
    },
    "assigned_to_employee": {
      "type": "string",
      "description": "Email of assigned employee"
    },
    "assigned_to_project": {
      "type": "string",
      "description": "Project ID if assigned to a project"
    },
    "location": {
      "type": "string",
      "description": "Current location/storage"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date of purchase"
    },
    "purchase_price": {
      "type": "number",
      "description": "Purchase price in USD"
    },
    "last_maintenance_date": {
      "type": "string",
      "format": "date",
      "description": "Last maintenance/service date"
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled maintenance date"
    },
    "maintenance_interval_days": {
      "type": "number",
      "description": "How often maintenance is required in days",
      "default": 90
    },
    "maintenance_notes": {
      "type": "string",
      "description": "Maintenance history or notes"
    },
    "photo_url": {
      "type": "string",
      "description": "Equipment photo URL"
    },
    "condition": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "notes": {
      "type": "string",
      "description": "General notes"
    }
  },
  "required": [
    "name",
    "type"
  ]
}